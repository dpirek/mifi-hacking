#!/bin/sh
# Short press: status; double press: Wi-Fi QR; triple press: latest SMS; hold: power off.
[ "${BUTTON:-power}" = power ] || exit 0
FIFO=${POWER_BUTTON_FIFO:-$(uci -q get display.display.fifo)}
FIFO=${FIFO:-/var/run/display.fifo}
STATE=${POWER_BUTTON_STATE:-/var/run/power-button.last}

show_display() {
    [ -p "$FIFO" ] || return 0
    # Never hang the button handler if the display daemon is unavailable.
    (exec 9<>"$FIFO"; printf '%s\n' "$1" >&9) 2>/dev/null || :
}

case "$ACTION" in
    pressed)
        show_display full
        ;;
    released)
        case "$SEEN" in ''|*[!0-9]*) exit 0 ;; esac
        if [ "$SEEN" -ge 3 ]; then
            rm -f "$STATE"
            logger -t power-button 'Long press: powering off'
            sync
            "${POWER_BUTTON_POWEROFF:-/sbin/poweroff}"
            exit $?
        fi
        now=$(awk '{printf "%.0f\n", $1 * 100}' "${POWER_BUTTON_UPTIME:-/proc/uptime}")
        previous=0; count=0
        [ ! -f "$STATE" ] || read -r previous count < "$STATE" 2>/dev/null || :
        case "$count" in 1|2) : ;; *) count=1 ;; esac
        case "$previous" in ''|*[!0-9]*) previous=0 ;; esac
        elapsed=$((now - previous))
        if [ "$previous" -gt 0 ] && [ "$elapsed" -ge 0 ] && [ "$elapsed" -le 50 ]; then
            count=$((count + 1))
            if [ "$count" -ge 3 ]; then
                rm -f "$STATE"
                show_display sms
            else
                printf '%s 2\n' "$now" > "$STATE"
                show_display wifi
            fi
        else
            printf '%s 1\n' "$now" > "$STATE"
            show_display full
        fi
        ;;
esac
exit 0
