+/* Publish acknowledged writes, not queued pwrite calls. /var/run is tmpfs. */
+static void storage_publish_state(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    FILE *file = fopen(RMTFS_STORAGE_STATE ".new", "w");
+    if (!file) return;
+    fprintf(file, "1 %ld %llu %llu %lld %d %d\n", (long)getpid(),
+            storage_write_seq, storage_ack_bytes,
+            (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000,
+            storage_read_only, storage_last_error);
+    if (fclose(file) == 0)
+        rename(RMTFS_STORAGE_STATE ".new", RMTFS_STORAGE_STATE);
+}
