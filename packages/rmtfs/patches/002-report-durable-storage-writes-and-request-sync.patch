+static void send_force_sync(int sock)
+{
+    for (int i = 0; i < 10; i++) {
+        if (!sync_clients[i].active) continue;
+        bool sent = false;
+        for (int j = 0; j < i; j++)
+            if (sync_clients[j].active && sync_clients[j].node == sync_clients[i].node && sync_clients[j].port == sync_clients[i].port) sent = true;
+        if (sent) continue;
+        struct rmtfs_force_sync request = {0};
+        for (int j = i; j < 10; j++)
+            if (sync_clients[j].active && sync_clients[j].node == sync_clients[i].node && sync_clients[j].port == sync_clients[i].port)
+                request.caller_id[request.caller_id_len++] = j;
+        DEFINE_QRTR_PACKET(packet, 256);
+        int length = qmi_encode_message(&packet, QMI_INDICATION, QMI_RMTFS_FORCE_SYNC_IND, 0, &request, rmtfs_force_sync_ei);
+        int result = length < 0 ? length : qrtr_sendto(sock, sync_clients[i].node, sync_clients[i].port, packet.data, packet.data_len);
+        fprintf(stderr, "[force-sync] clients=%zu peer=%u:%u result=%d\n", request.caller_id_len, sync_clients[i].node, sync_clients[i].port, result);
+    }
+}
