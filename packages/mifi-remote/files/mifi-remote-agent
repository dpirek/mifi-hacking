#!/bin/sh
. /usr/share/libubox/jshn.sh
umask 077
config_dir=${MIFI_REMOTE_CONFIG_DIR:-/etc/config}
status_file=${MIFI_REMOTE_STATUS_FILE:-/var/run/mifi-remote.json}
uci_get() { uci -c "$config_dir" -q get "mifi-remote.main.$1"; }
status() {
 json_init; json_add_string state "$1"; json_add_string message "$2"; json_add_int updated "$(date +%s)"
 json_dump > "$status_file.tmp"; mv "$status_file.tmp" "$status_file"
}
[ "$(uci_get enabled)" = 1 ] || { status disabled 'Remote management is disabled'; exit 0; }
server=$(uci_get server); token=$(uci_get token)
case "$server" in https://*) ;; http://*) [ "$MIFI_REMOTE_ALLOW_HTTP" = 1 ] || exit 1 ;; *) exit 1 ;; esac
printf '%s' "$server" | grep -Eq '^https?://[a-zA-Z0-9.-]+(:[0-9]{1,5})?$' || exit 1
case "$token" in ''|*[!a-f0-9]*) exit 1 ;; esac
[ "${#token}" = 64 ] || exit 1
work=$(mktemp -d /tmp/mifi-remote.XXXXXX) || exit 1
trap 'rm -rf "$work"' EXIT
trap 'exit 0' INT TERM HUP
# Keep the token out of process arguments. curl does not follow redirects.
printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$token" > "$work/curl.conf"
post() {
 curl --config "$work/curl.conf" --silent --show-error --fail --connect-timeout 10 --max-time 35 \
  --output "$work/response" --data-binary "@$2" "$server/api/agent/$1" 2> "$work/error"
}
printf '{}' > "$work/poll"
status connecting 'Connecting to management server'
while :; do
 if ! post poll "$work/poll"; then
  status error 'Connection failed. Check the server address, token, internet access and router clock.'
  [ "$1" != --once ] || exit 1
  sleep 10; continue
 fi
 status connected 'Management server connected'
 job=$(cat "$work/response")
 if ! jsonfilter -s "$job" -e '@.id' > "$work/id" 2>/dev/null; then
  [ "$1" != --once ] || exit 0
  continue
 fi
 id=$(cat "$work/id")
 case "$id" in ''|*[!a-f0-9-]*) status error 'Invalid server request'; exit 1 ;; esac
 [ "${#id}" = 36 ] || exit 1
 # Dispatch each delivered job exactly once, including when result delivery fails.
 result=$(printf '%s\n' "$job" | /usr/libexec/mifi-remote-dispatch)
 jsonfilter -s "$result" -e '@' >/dev/null 2>&1 || result='{"error":"Router action failed"}'
 printf '{"id":"%s","result":%s}\n' "$id" "$result" > "$work/result"
 if ! post result "$work/result"; then status error 'Result delivery failed; action was not retried'; fi
 [ "$1" != --once ] || exit 0
 sleep 1
done
