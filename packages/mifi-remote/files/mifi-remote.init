#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 [ "$(uci -q get mifi-remote.main.enabled)" = 1 ] || return 0
 procd_open_instance
 procd_set_param command /usr/bin/mifi-remote-agent
 procd_set_param respawn 3600 10 0
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger mifi-remote; }
