config display 'display'
        option timeout_dim '60'
        option timeout_off '3'
        option brightness_dim_divisor '8'
        option fifo '/var/run/display.fifo'
        option enable_lockscreen '1'
        option page 'status'
        option traffic_interface 'auto'
        option update_interval '1'
        option clock_brightness_percent '10'
        option traffic_scale_mbps '10'
